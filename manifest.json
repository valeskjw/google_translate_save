{
  "manifest_version": 3,
  "name": "SpanishDict Vocabulary Saver",
  "version": "1.0",
  "description": "Saves translated terms from SpanishDict to a dictionary text file and exports to Anki.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "translate_highlight": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Alt+T"
      },
      "description": "Translate selected text and open translator"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.spanishdict.com/translate/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ]
}